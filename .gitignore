# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# ephemeral artifact-generation workspaces
/outputs/

# production
/build

# misc
.DS_Store
*.pem
*.key

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# Local credentials and database backups; source migrations and SQL tests remain trackable.
**/credentials.json
/backups/
/supabase/backups/
*.dump
*.dump.gz
*.backup
*.backup.gz
*.sql.gz

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Private REVA references; customer-facing pages and public project documentation remain trackable.
/docs/private/
